---
// src/pages/cautions.astro
// 共通の注意点ページ。要件§17.1の共通注意（12項目）を一覧する静的ページ。
// 注意カードのスタイルは MethodDetail.astro の「注意点」ブロックと統一
// （bg-card / border-line / border-l-[3px] border-l-[#B45309] / 警告三角アイコン）。
import BaseLayout from '../layouts/BaseLayout.astro';

const CAUTIONS: { title: string; body: string }[] = [
  {
    title: '相関は因果を意味しない',
    body: '2つの値が一緒に動いても、片方がもう片方の原因とは限りません。季節など第3の要因が両方を動かしているだけのこともあります。',
  },
  {
    title: '外れ値が結果に大きく影響することがある',
    body: '極端な値が数件あるだけで平均や傾きが大きく変わります。分析の前に分布を確認し、外れ値の扱いを決めておきましょう。',
  },
  {
    title: '欠損値の扱いによって結果が変わる',
    body: '欠損を削除するか補完するか、その方法によって結論が変わります。欠損が偏って発生していないかも確認しましょう。',
  },
  {
    title: 'データの偏りによって分析結果が歪む',
    body: '集めたデータが対象全体を代表していないと、結果は実態とずれます。どんな範囲・条件で集めたデータかを意識しましょう。',
  },
  {
    title: 'サンプルサイズが小さいと信頼性が下がる',
    body: 'データ件数が少ないと、たまたまの偏りに結果が振り回されやすくなります。少数のデータから断定するのは避けましょう。',
  },
  {
    title: '過学習に注意する',
    body: '手元のデータに合わせ込みすぎると、未知のデータでは精度が落ちます。学習に使っていないデータで性能を確かめましょう。',
  },
  {
    title: '正規化・標準化が必要な手法がある',
    body: '距離や大きさを使う手法では、単位や桁の違う変数をそろえないと特定の変数だけが効きすぎます。手法ごとに前処理の要否を確認しましょう。',
  },
  {
    title: 'カテゴリ変数の扱いに注意する',
    body: '文字や区分のデータは、そのままでは多くの手法に使えません。ダミー変数化など適切な数値化が必要で、方法によって結果も変わります。',
  },
  {
    title: '時系列データは時間順序を壊さない',
    body: '時間に沿って並ぶデータは、順番そのものに意味があります。無作為に並べ替えたり、未来の情報を使って過去を予測したりしないようにしましょう。',
  },
  {
    title: '高次元データでは距離の意味が薄れることがある',
    body: '変数（次元）が多すぎると、点どうしの距離の差が小さくなり「近い・遠い」の判断が効きにくくなります。次元削減や変数の絞り込みを検討しましょう。',
  },
  {
    title: '検定では多重比較に注意する',
    body: '同じデータで何度も検定を繰り返すと、偶然「差あり」と出る確率が高まります。比較の回数に応じた補正を検討しましょう。',
  },
  {
    title: 'AIの分析結果は必ず検証する',
    body: 'AIの出力はもっともらしく見えても誤りを含むことがあります。前提・手法・数値が妥当かを自分で確認してから使いましょう。',
  },
];
---
<BaseLayout
  title="共通の注意点 | 分析手法アトラス"
  description="どの分析手法を使うときにも共通してつまずきやすいポイントをまとめた、結果を読み解く前提の注意点集。"
>
  <section class="pb-12">
    <h1 class="mt-4 font-display text-2xl font-bold">共通の注意点</h1>
    <p class="mt-2 mb-7 max-w-[70ch] text-ink-soft">
      どの分析手法を使うときにも共通してつまずきやすいポイントをまとめました。手法ページの個別の注意点と合わせて、結果を読み解くときの前提として確認してください。
    </p>

    <div class="flex flex-col gap-2">
      {
        CAUTIONS.map((c) => (
          <div class="flex items-start gap-3 rounded-r border border-line border-l-[3px] border-l-[#B45309] bg-card px-3.5 py-3 text-[0.92rem] text-ink-soft">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="mt-[3px] flex-none text-[#B45309]"
              aria-hidden="true"
            >
              <path d="M12 9v4M12 17h.01M10.3 3.9L2 18a2 2 0 001.7 3h16.6a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z" />
            </svg>
            <span>
              <b class="text-ink">{c.title}。</b>
              {c.body}
            </span>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
