---
// src/components/MethodChart.astro
// サンプル分布チャートを静的SVGで描画する（クライアントJS・チャートライブラリ不使用）。
// mockup/method.html の「サンプルで見る」図（手描き風の散布図・棒・軸線）を踏襲。
import type { SampleChart } from '../lib/chart';
import { scalePoints, extent } from '../lib/chart';

interface Props {
  chart: SampleChart;
}

const { chart } = Astro.props;

// 描画領域。viewBox でレスポンシブに伸縮する。
const W = 300;
const H = 220;
const PAD = 40;

// 複数系列の配色（mockup の signal/water/gold を踏襲）。
const SERIES_COLORS = [
  'var(--color-signal)',
  'var(--color-water)',
  'var(--color-gold)',
];
const colorFor = (i: number) => SERIES_COLORS[i % SERIES_COLORS.length];

const supported = ['scatter', 'line', 'bar', 'histogram'].includes(chart.type);

// bar / histogram 用：全系列の値（y）から高さの基準スケールを作る。
// 棒は x を等間隔に置き、y(値) で高さを決める。
const isBars = chart.type === 'bar' || chart.type === 'histogram';
let barGroups: { color: string; bars: { x: number; y: number; w: number; h: number }[] }[] = [];
if (isBars) {
  // 全系列の本数（最大）と値域から、棒幅と高さを決める。
  const allValues = chart.series.flatMap((s) => s.points.map((p) => p[1]));
  const [, vhi] = extent(allValues);
  const base = Math.max(vhi, 0); // 0 を底とした高さ（値は非負を想定）
  const maxCount = Math.max(1, ...chart.series.map((s) => s.points.length));
  const plotW = W - 2 * PAD;
  const plotH = H - 2 * PAD;
  // 系列ごとに棒をまとめ、系列内で等間隔配置・系列間は少しずらす。
  const slot = plotW / maxCount;
  const groupCount = chart.series.length;
  const barW = (slot * 0.62) / groupCount;
  barGroups = chart.series.map((s, si) => ({
    color: colorFor(si),
    bars: s.points.map((p, i) => {
      const h = base > 0 ? (p[1] / base) * plotH : 0;
      const cx = PAD + slot * (i + 0.5) - (groupCount * barW) / 2 + si * barW;
      return { x: cx, y: H - PAD - h, w: barW, h };
    }),
  }));
}

// scatter / line 用：系列ごとに scalePoints で座標化。
const isScatter = chart.type === 'scatter';
const isLine = chart.type === 'line';
let scaledSeries: { color: string; pts: { x: number; y: number }[] }[] = [];
if (isScatter || isLine) {
  scaledSeries = chart.series.map((s, si) => ({
    color: colorFor(si),
    pts: scalePoints(s.points, { width: W, height: H, pad: PAD }),
  }));
}
---
<figure class="my-4">
  {
    supported ? (
      <svg
        viewBox={`0 0 ${W} ${H}`}
        role="img"
        aria-label={chart.caption ?? 'サンプル分布のグラフ'}
        class="w-full max-w-[420px]"
      >
        {/* 軸線 */}
        <line
          x1={PAD}
          y1={H - PAD}
          x2={W - 15}
          y2={H - PAD}
          stroke="var(--color-line-strong)"
          stroke-width="1"
        />
        <line
          x1={PAD}
          y1={20}
          x2={PAD}
          y2={H - PAD}
          stroke="var(--color-line-strong)"
          stroke-width="1"
        />
        {/* 軸ラベル */}
        <text
          x={W - 15}
          y={H - PAD + 16}
          text-anchor="end"
          font-family="var(--font-mono)"
          font-size="9"
          fill="var(--color-ink-faint)"
        >
          x →
        </text>
        <text
          x={PAD - 6}
          y={24}
          text-anchor="end"
          font-family="var(--font-mono)"
          font-size="9"
          fill="var(--color-ink-faint)"
          transform={`rotate(-90 ${PAD - 6} 24)`}
        >
          値 →
        </text>

        {/* bar / histogram */}
        {isBars &&
          barGroups.map((g) =>
            g.bars.map((b) => (
              <rect
                x={b.x}
                y={b.y}
                width={b.w}
                height={b.h}
                fill={g.color}
                opacity="0.85"
                rx="1"
              />
            ))
          )}

        {/* line */}
        {isLine &&
          scaledSeries.map((s) => (
            <polyline
              points={s.pts.map((p) => `${p.x},${p.y}`).join(' ')}
              fill="none"
              stroke={s.color}
              stroke-width="1.8"
              stroke-linejoin="round"
              stroke-linecap="round"
            />
          ))}

        {/* scatter */}
        {isScatter &&
          scaledSeries.map((s) =>
            s.pts.map((p) => (
              <circle cx={p.x} cy={p.y} r="3" fill={s.color} opacity="0.85" />
            ))
          )}
      </svg>
    ) : (
      <p class="rounded border border-line bg-paper2 px-4 py-6 text-center text-sm text-ink-faint">
        （この種別のサンプル可視化は準備中）
      </p>
    )
  }
  {
    chart.caption && (
      <figcaption class="mt-2 font-mono text-xs text-ink-faint">
        {chart.caption}
      </figcaption>
    )
  }
</figure>
