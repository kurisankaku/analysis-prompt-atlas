---
// src/components/diagrams/TreeDiagram.astro
// 決定木（type:'tree'）の模式図。ensemble>1 で複数の木を並べてランダムフォレストの
// 「多数決」を表現する。色は @theme トークンのみ（生hex不使用）。
import { layoutTree } from '../../lib/tree-layout';
import { tokenToVar } from '../../lib/chart-config';
import type { SampleChartConfig } from '../../content/schema';

type TreeConfig = Extract<SampleChartConfig, { type: 'tree' }>;
interface Props { config: TreeConfig }
const { config } = Astro.props;

const W = 640;
const ensemble = Math.max(1, config.ensemble ?? 1);
const layout = layoutTree(config.root);
const depth = layout.depth;
const nodes = layout.nodes;
const edges = layout.edges;

const H = ensemble > 1 ? 300 : 340;
const topPad = 30;
const botPad = ensemble > 1 ? 48 : 26;
const levelH = (H - topPad - botPad) / Math.max(1, depth);
const bandGap = 18;
const bandW = (W - bandGap * (ensemble - 1)) / ensemble;
const sidePad = ensemble > 1 ? 16 : 44;
const boxH = ensemble > 1 ? 20 : 28;
const fs = ensemble > 1 ? 8.5 : 12;
const efs = ensemble > 1 ? 8 : 10.5;
const nodeW = ensemble > 1 ? bandW * 0.66 : 132;

const place = (band: number, nx: number, d: number) => {
  const bx0 = band * (bandW + bandGap);
  return { x: bx0 + sidePad + nx * (bandW - 2 * sidePad), y: topPad + d * levelH };
};
const bands = Array.from({ length: ensemble }, (_, i) => i);

const drawEdges = bands.flatMap((band) =>
  edges.map((e) => ({
    band,
    label: e.label,
    a: place(band, nodes[e.from].x, nodes[e.from].depth),
    b: place(band, nodes[e.to].x, nodes[e.to].depth),
  })),
);
const drawNodes = bands.flatMap((band) =>
  nodes.map((n) => ({ band, n, p: place(band, n.x, n.depth) })),
);
---
<svg
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-label={config.caption ?? '決定木の模式図'}
  class="block h-auto w-full"
>
  {/* 枝（線） */}
  <g stroke="var(--color-line-strong)" stroke-width="1.3" fill="none">
    {drawEdges.map((e) => (
      <line x1={e.a.x} y1={e.a.y + boxH / 2} x2={e.b.x} y2={e.b.y - boxH / 2} />
    ))}
  </g>

  {/* 枝ラベル（はい／いいえ など） */}
  <g
    text-anchor="middle"
    font-family="var(--font-body)"
    font-size={efs}
    paint-order="stroke"
    stroke="var(--color-card)"
    stroke-width="3"
    stroke-linejoin="round"
    fill="var(--color-ink-soft)"
  >
    {drawEdges.map((e) =>
      e.label ? (
        <text x={(e.a.x + e.b.x) / 2} y={(e.a.y + e.b.y) / 2} dy="0.3em">{e.label}</text>
      ) : null,
    )}
  </g>

  {/* ノード（判定＝枠、葉＝色付き） */}
  {drawNodes.map(({ n, p }) => {
    const leafFill = tokenToVar(n.leafColor, 'good');
    return (
      <g>
        <rect
          x={p.x - nodeW / 2}
          y={p.y - boxH / 2}
          width={nodeW}
          height={boxH}
          rx="5"
          fill={n.isLeaf ? leafFill : 'var(--color-card)'}
          fill-opacity={n.isLeaf ? 0.22 : 1}
          stroke={n.isLeaf ? leafFill : 'var(--color-line-strong)'}
          stroke-width="1.4"
        />
        <text
          x={p.x}
          y={p.y}
          dy="0.34em"
          text-anchor="middle"
          font-family="var(--font-body)"
          font-size={fs}
          font-weight={n.isLeaf ? 700 : 600}
          fill="var(--color-ink)"
        >
          {n.isLeaf ? (n.leaf ?? n.label) : n.label}
        </text>
      </g>
    );
  })}

  {/* アンサンブルの木番号と多数決 */}
  {ensemble > 1 &&
    bands.map((band) => (
      <text
        x={place(band, 0.5, 0).x}
        y={H - botPad + 20}
        text-anchor="middle"
        font-family="var(--font-mono)"
        font-size="9"
        fill="var(--color-ink-faint)"
      >
        {`木${band + 1}`}
      </text>
    ))}
  {ensemble > 1 && config.result && (
    <text
      x={W / 2}
      y={H - 10}
      text-anchor="middle"
      font-family="var(--font-body)"
      font-size="11.5"
      font-weight="700"
      fill="var(--color-signal)"
    >
      {`多数決 → ${config.result}`}
    </text>
  )}
</svg>
