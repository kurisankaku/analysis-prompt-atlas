---
// src/components/DerivationSteps.astro
// 「計算の手順」セクション。一般式（数式）＋平易な説明＋ページの例の数値を代入した
// ワークドエグザンプルを、ステップごとに並べる。数学が苦手でも追える構成にする。
import type { Derivation } from '../content/schema';
import MathFormula from './MathFormula.astro';

interface Props {
  derivation: Derivation;
}
const { derivation } = Astro.props;
---
<section class="border-b border-line py-7">
  <h2 class="flex items-center gap-3 text-[1.28rem] font-bold">
    <span class="h-5 w-[7px] flex-none rounded-[1px] bg-signal" aria-hidden="true"></span>
    計算の手順（数式と意味）
  </h2>

  {derivation.intro && <p class="mt-3.5 text-ink">{derivation.intro}</p>}

  {
    derivation.symbols.length > 0 && (
      <dl class="mt-4 grid gap-x-6 gap-y-2 rounded border border-line bg-card px-4 py-3.5 text-[0.9rem] sm:grid-cols-2">
        <div class="col-span-full font-mono text-[0.7rem] tracking-wide text-water">
          記号の意味
        </div>
        {derivation.symbols.map((s) => (
          <div class="flex items-baseline gap-2">
            <dt class="flex-none text-ink">
              <MathFormula tex={s.sym} />
            </dt>
            <dd class="text-ink-soft">… {s.meaning}</dd>
          </div>
        ))}
      </dl>
    )
  }

  <ol class="mt-5 flex flex-col gap-4">
    {
      derivation.steps.map((step, i) => (
        <li class="rounded border border-line bg-card px-4 py-4">
          <div class="flex items-center gap-2">
            <span class="flex size-6 flex-none items-center justify-center rounded-full bg-signal text-xs font-bold text-paper">
              {i + 1}
            </span>
            <span class="font-mono text-[0.7rem] tracking-wide text-ink-faint">
              STEP {i + 1}
            </span>
          </div>

          <div class="mt-3 text-[1.05rem] text-ink">
            <MathFormula tex={step.formula} display />
          </div>

          <p class="mt-3 text-[0.94rem] leading-relaxed text-ink-soft">{step.explain}</p>

          {step.example && (
            <div class="mt-3 rounded border border-line bg-paper2 px-3.5 py-3">
              <div class="font-mono text-[0.7rem] tracking-wide text-water">
                数字で確認
              </div>
              <div class="mt-1.5 text-ink">
                <MathFormula tex={step.example} display />
              </div>
              {step.result && (
                <p class="mt-1.5 text-[0.9rem] font-bold text-signal-deep">→ {step.result}</p>
              )}
            </div>
          )}
        </li>
      ))
    }
  </ol>
</section>
